# Copy this file to `.env` before you run the stack.
# These defaults are safe for local development and can be changed later.

# Grafana credentials used by the Docker Compose stack.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# AWS values are only used by `scripts/export_to_s3.py`.
# Leave them blank until you reach the S3 export stage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
S3_BUCKET_NAME=

# Optional: override the dashboard file that will be exported.
DASHBOARD_FILE=grafana/dashboards/nexaplay-overview.json
